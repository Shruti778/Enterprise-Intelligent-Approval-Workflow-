NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=approval_workflow
DB_USER=your_local_user
DB_PASSWORD=your_local_password
DB_DIALECT=postgres
# true for hosted Postgres (Neon/Supabase/RDS), false for a local server
DB_SSL=false
# Keep this small on serverless (Vercel) so warm instances do not exhaust the pool
DB_POOL_MAX=10

JWT_SECRET=your_secret
JWT_EXPIRES_IN=12h

CORS_ORIGIN=http://localhost:3000,http://localhost:3001
